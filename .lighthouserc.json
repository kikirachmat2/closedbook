{
  "ci": {
    "collect": {
      "numberOfRuns": 3,
      "startServerCommand": "npm run start",
      "url": ["http://localhost:3000/workspace", "http://localhost:3000/privacy", "http://localhost:3000/terms"],
      "settings": {
        "preset": "desktop"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["warn", { "minScore": 0.9 }],
        "categories:pwa": ["warn", { "minScore": 0.9 }],
        "resource-summary:script:size": ["warn", { "maxNumericValue": 310000 }]
      },
      "budgets": [
        {
          "path": "/*",
          "resourceSizes": [
            {
              "resourceType": "script",
              "budget": 310
            }
          ]
        },
        {
          "path": "/workspace",
          "comment": "Route chunk budget < 60 KB gzipped, vendor cache < 250 KB gzipped",
          "resourceSizes": [
            {
              "resourceType": "script",
              "budget": 310
            }
          ]
        }
      ]
    }
  }
}
